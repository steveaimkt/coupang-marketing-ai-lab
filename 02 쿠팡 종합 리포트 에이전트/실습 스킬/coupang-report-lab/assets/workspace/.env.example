# 이 파일을 .env 로 복사해서 값을 채웁니다. .env 는 밖으로 올리지 않습니다 (훅이 막습니다).
# 노션 · 설정 > 연결 > 통합 만들기 에서 받은 키와, 리포트를 올릴 페이지 ID
NOTION_API_KEY=
NOTION_PAGE_ID=
# 메신저 · 둘 중 쓰는 것 하나만 채웁니다. 둘 다 채우면 슬랙으로 보내고, 디스코드는 --to discord
# 슬랙 · api.slack.com/apps 에서 Incoming Webhook (Create New App > Blank app · AI agent 아님 > Incoming Webhooks > Add New Webhook)
# 디스코드 · 채널 편집 > 연동 > 웹후크 (새 웹후크 > 웹후크 URL 복사)
# 웹훅 주소는 비밀번호와 같습니다. 여기에 직접 붙여 넣고 채팅창에는 붙여 넣지 않습니다
# 슬랙은 https://hooks.slack.com/services/ 로, 디스코드는 https://discord.com/api/webhooks/ 로 시작합니다
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
